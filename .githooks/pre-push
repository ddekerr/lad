#!/bin/sh
# Заборона пушу в main (поза пул-реквестом). Справжній захист це налаштування гілки на GitHub, це лише швидка підказка.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Пуш у main заборонено. Запуш гілку й злий пул-реквест на GitHub." >&2
    exit 1
  fi
done
exit 0
