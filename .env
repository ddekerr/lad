# Спільні значення для локальної розробки. Секретів тут немає, тож файл комітимо.
# Його читають і Next.js, і Prisma CLI. Змінні, задані в оточенні (CI, хостинг), мають пріоритет.
# Свої секрети (AUTH_SECRET, SUPER_ADMIN_EMAIL, ключі) кладіть у .env.local: він не комітиться й перекриває цей файл.

# Локальна база SQLite: файл prisma/dev.db (шлях рахується від папки prisma/).
# Створюється командою `npm run db:migrate`, у git не потрапляє.
DATABASE_URL=file:./dev.db

APP_URL=http://localhost:3000
