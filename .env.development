# Налаштування для локальної розробки (`npm run dev` і команди db:*). Секретів тут немає, тож файл комітимо.
# Next.js підхоплює його у `next dev`, а команди db:* підтягують його через `node --env-file` (див. package.json).
# Свої секрети (AUTH_SECRET, SUPER_ADMIN_EMAIL, ключі) кладіть у .env.local: він не комітиться й перекриває цей файл.

# Локальна база SQLite: файл prisma/dev.db (шлях рахується від папки prisma/, де лежить schema.prisma).
# Створюється командою `npm run db:migrate`, у git не потрапляє.
DATABASE_URL=file:./dev.db

APP_URL=http://localhost:3000
