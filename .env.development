# Налаштування для локальної розробки (docker-compose.yml + `npm run dev`). Секретів тут немає, тож файл комітимо.
# Next.js підхоплює його у `next dev`, а команди db:* підтягують його через scripts/with-env.mjs.
# Свої секрети (AUTH_SECRET, SUPER_ADMIN_EMAIL, ключі) кладіть у .env.local: він не комітиться й перекриває цей файл.

# Контейнер бази (docker-compose.yml)
POSTGRES_USER=lad
POSTGRES_PASSWORD=lad_dev
POSTGRES_DB=lad
DB_PORT=5432

# З'єднання застосунку й міграцій з локальною базою (у розробці пулера нема, обидва однакові)
DATABASE_URL=postgresql://lad:lad_dev@localhost:5432/lad?schema=public
DATABASE_URL_POOLING=postgresql://lad:lad_dev@localhost:5432/lad?schema=public

APP_URL=http://localhost:3000
