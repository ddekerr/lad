# Скопіюй цей файл у .env і заповни значення. Файл .env не комітимо.

# PostgreSQL (збігається з docker-compose.yml)
DATABASE_URL="postgresql://lad:lad@localhost:5432/lad?schema=public"
# Пряме з\'єднання для міграцій. Локально те саме; для Supabase порт 5432 замість пулера 6543
DIRECT_URL="postgresql://lad:lad@localhost:5432/lad"

# Публічна адреса застосунку (потрібна для Google-входу й редіректів)
APP_URL="http://localhost:3000"

# Секрет для хешування кодів входу: довгий випадковий рядок (мінімум 16 символів).
# Згенерувати: openssl rand -base64 32
AUTH_SECRET=""

# Супер-адмін: email (або кілька через кому). Завжди має роль адміна, яку не можна зняти.
SUPER_ADMIN_EMAIL=""

# Вхід через Google (необов'язково; без цього кнопка Google покаже повідомлення).
# Redirect URI в Google Cloud Console: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Пошта для кодів входу. Якщо SMTP_HOST порожній, код виводиться в консоль сервера (лише для розробки).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Лад <no-reply@example.com>"
